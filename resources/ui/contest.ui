<?xml version="1.0" encoding="UTF-8"?>
<!-- Converti depuis resources/glade/contest.glade (GTK2) vers GTK4.
     Préfixe des actions de menus : contest -->
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkDialog" id="calendar_dialog">
    <property name="title" translatable="yes">Date of competition</property>
    <property name="destroy-with-parent">True</property>
    <child internal-child="content_area">
      <object class="GtkBox" id="dialog-vbox2">
        <property name="orientation">vertical</property>
        <property name="spacing">2</property>
        <child>
          <object class="GtkCalendar" id="calendar">
            <property name="vexpand">True</property>
          </object>
        </child>
      </object>
    </child>
    <child type="action">
      <object class="GtkButton" id="button3">
        <property name="receives-default">True</property>
        <child>
          <object class="GtkBox">
            <property name="spacing">4</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">object-select-symbolic</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="yes">_OK</property>
                <property name="use-underline">True</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child type="action">
      <object class="GtkButton" id="button4">
        <property name="receives-default">True</property>
        <child>
          <object class="GtkBox">
            <property name="spacing">4</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">process-stop</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="yes">_Cancel</property>
                <property name="use-underline">True</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <action-widgets>
      <action-widget response="1">button3</action-widget>
      <action-widget response="0">button4</action-widget>
    </action-widgets>
  </object>
  <object class="GtkListStore" id="category_liststore">
    <columns>
      <column type="gchararray" />
    </columns>
  </object>
  <object class="GtkAdjustment" id="checkin_hour_adjustment">
    <property name="upper">24</property>
    <property name="value">12</property>
    <property name="step-increment">1</property>
    <property name="page-increment">5</property>
  </object>
  <object class="GtkAdjustment" id="checkin_minute_adjustment">
    <property name="upper">59</property>
    <property name="step-increment">1</property>
    <property name="page-increment">5</property>
  </object>
  <object class="GtkListStore" id="color_liststore">
    <columns>
      <column type="gchararray" />
    </columns>
  </object>
  <object class="GtkListStore" id="label_liststore">
    <columns>
      <column type="gchararray" />
    </columns>
    <data>
      <row>
        <col id="0">Tableau A</col>
      </row>
      <row>
        <col id="0">Tableau B</col>
      </row>
      <row>
        <col id="0">N1</col>
      </row>
      <row>
        <col id="0">N2</col>
      </row>
    </data>
  </object>
  <object class="GtkAdjustment" id="scratch_hour_adjustment">
    <property name="upper">24</property>
    <property name="value">12</property>
    <property name="step-increment">1</property>
    <property name="page-increment">5</property>
  </object>
  <object class="GtkAdjustment" id="scratch_minute_adjustment">
    <property name="upper">59</property>
    <property name="value">15</property>
    <property name="step-increment">1</property>
    <property name="page-increment">5</property>
  </object>
  <object class="GtkAdjustment" id="start_hour_adjustment">
    <property name="upper">24</property>
    <property name="value">12</property>
    <property name="step-increment">1</property>
    <property name="page-increment">5</property>
  </object>
  <object class="GtkAdjustment" id="start_minute_adjustment">
    <property name="upper">59</property>
    <property name="value">30</property>
    <property name="step-increment">1</property>
    <property name="page-increment">5</property>
  </object>
  <object class="GtkDialog" id="properties_dialog">
    <property name="title" translatable="yes">Competition properties</property>
    <property name="destroy-with-parent">True</property>
    <signal name="close-request" handler="gtk_widget_hide" swapped="no" />
