<?xml version="1.0" encoding="UTF-8"?>
<!-- Converti depuis resources/glade/pool_supervisor.glade (GTK2) vers GTK4.
     Préfixe des actions de menus : pool-supervisor -->
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkImage" id="combined_score_image">
    <property name="file">../glade/images/stock_combined_scores.png</property>
    <property name="pixel-size">-1</property>
  </object>
  <object class="GtkAdjustment" id="nb_qualified_adjustment">
    <property name="upper">9999</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkWindow" id="configuration_window">
    <child>
      <object class="GtkFrame" id="stage_configuration">
        <property name="label-xalign">0</property>
        <child>
          <object class="GtkGrid" id="table1">
            <property name="row-spacing">10</property>
            <property name="column-spacing">10</property>
            <child>
              <object class="GtkLabel" id="label4">
                <property name="xalign">0</property>
                <property name="label" translatable="yes">Name</property>
                <property name="vexpand">True</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">0</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="label2">
                <property name="xalign">0</property>
                <property name="label" translatable="yes">Max score</property>
                <property name="vexpand">True</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">1</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="label1">
                <property name="xalign">0</property>
                <property name="label" translatable="yes">Qualified</property>
                <property name="vexpand">True</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">2</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkViewport" id="qualified_viewport">
                <child>
                  <object class="GtkGrid" id="qualified_table">
                    <property name="column-spacing">10</property>
                    <child>
                      <object class="GtkCheckButton" id="all_radiobutton">
                        <property name="receives-default">False</property>
                        <signal name="toggled" handler="on_all_radiobutton_toggled" swapped="no" />
                        <property name="label">100%</property>
                        <property name="active">True</property>
                        <property name="hexpand">True</property>
                        <property name="vexpand">True</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="number_radiobutton">
                        <property name="receives-default">False</property>
                        <property name="label" translatable="yes">Number</property>
                        <property name="active">True</property>
                        <property name="group">all_radiobutton</property>
                        <property name="hexpand">True</property>
                        <property name="vexpand">True</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSpinButton" id="nb_qualified_spinbutton">
                        <property name="adjustment">nb_qualified_adjustment</property>
                        <property name="numeric">True</property>
                        <property name="visible">False</property>
                        <property name="hexpand">True</property>
                        <property name="vexpand">True</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                  </object>
                </child>
                <property name="hexpand">True</property>
                <property name="vexpand">True</property>
                <layout>
                  <property name="column">1</property>
                  <property name="row">2</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkViewport" id="viewport3">
                <child>
                  <object class="GtkEntry" id="max_score_entry" />
                </child>
                <property name="hexpand">True</property>
                <property name="vexpand">True</property>
                <layout>
                  <property name="column">1</property>
                  <property name="row">1</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkViewport" id="viewport4">
                <child>
                  <object class="GtkEntry" id="name_entry">
                    <property name="max-length">15</property>
                  </object>
                </child>
                <property name="hexpand">True</property>
                <property name="vexpand">True</property>
                <layout>
                  <property name="column">1</property>
                  <property name="row">0</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="label9">
                <property name="xalign">0</property>
                <property name="label" translatable="yes">Seeding</property>
                <property name="vexpand">True</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">3</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkViewport" id="seeding_viewport">
                <child>
                  <object class="GtkBox" id="vbox3">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkCheckButton" id="balanced_radiobutton">
                        <property name="receives-default">False</property>
                        <property name="label" translatable="yes">Balanced</property>
                        <property name="active">True</property>
                        <property name="vexpand">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="strength_radiobutton">
                        <property name="receives-default">False</property>
                        <property name="label" translatable="yes">Grouped by strength</property>
                        <property name="group">balanced_radiobutton</property>
                        <property name="vexpand">True</property>
                      </object>
                    </child>
                  </object>
                </child>
                <property name="hexpand">True</property>
                <property name="vexpand">True</property>
                <layout>
                  <property name="column">1</property>
                  <property name="row">3</property>
                </layout>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkListStore" id="pool_liststore">
    <columns>
      <column type="gchararray" />
      <column type="GdkPixbuf" />
    </columns>
  </object>
  <object class="GtkMessageDialog" id="print_pool_dialog">
    <property name="title" translatable="yes">Pool sheets printing</property>
    <property name="message-type">question</property>
    <property name="buttons">ok-cancel</property>
    <property name="text" translatable="yes">&lt;b&gt;&lt;big&gt;Print...&lt;/big&gt;&lt;/b&gt;</property>
    <property name="use-markup">True</property>
    <child internal-child="content_area">
      <object class="GtkBox" id="dialog-vbox">
        <property name="orientation">vertical</property>
        <property name="spacing">2</property>
        <child>
          <object class="GtkBox" id="vbox4">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkFrame" id="frame2">
                <property name="label-xalign">0</property>
                <child>
                  <object class="GtkFrame" id="aspectframe3">
                    <property name="label-xalign">0</property>
                    <child>
                      <object class="GtkBox" id="vbox1">
                        <property name="orientation">vertical</property>
                        <child>
                          <object class="GtkCheckButton" id="all_pool_radiobutton">
                            <property name="receives-default">False</property>
                            <property name="label" translatable="yes">All the pools</property>
                            <property name="active">True</property>
                            <property name="vexpand">True</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkCheckButton" id="single_pool_radiobutton">
                            <property name="receives-default">False</property>
                            <property name="label" translatable="yes">Only the selected pool</property>
                            <property name="group">all_pool_radiobutton</property>
                            <property name="vexpand">True</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child type="label">
                  <object class="GtkLabel" id="label3">
                    <property name="label" translatable="yes">&lt;b&gt;What?&lt;/b&gt;</property>
                    <property name="use-markup">True</property>
                  </object>
                </child>
                <property name="vexpand">True</property>
                <property name="valign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkFrame" id="frame1">
                <property name="label-xalign">0</property>
                <child>
                  <object class="GtkFrame" id="aspectframe2">
                    <property name="label-xalign">0</property>
                    <child>
                      <object class="GtkBox" id="vbox2">
                        <property name="orientation">vertical</property>
                        <child>
                          <object class="GtkCheckButton" id="for_referees_radiobutton">
                            <property name="receives-default">False</property>
                            <signal name="toggled" handler="on_for_referees_radiobutton_clicked" swapped="no" />
                            <property name="label" translatable="yes">For arbitration</property>
                            <property name="active">True</property>
                            <property name="vexpand">True</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox" id="hbox3">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">10</property>
                            <child>
                              <object class="GtkCheckButton" id="watermark_checkbutton">
                                <property name="receives-default">False</property>
                                <property name="label" translatable="yes">Matches watermarked</property>
                                <property name="hexpand">True</property>
                                <property name="margin-start">50</property>
                                <property name="margin-end">50</property>
                              </object>
                            </child>
                            <property name="vexpand">True</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkCheckButton" id="for_display_radiobutton">
                            <property name="receives-default">False</property>
                            <property name="label" translatable="yes">For the bulletin board</property>
                            <property name="group">for_referees_radiobutton</property>
                            <property name="vexpand">True</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child type="label">
                  <object class="GtkLabel" id="label5">
                    <property name="label" translatable="yes">&lt;b&gt;For what?&lt;/b&gt;</property>
                    <property name="use-markup">True</property>
                  </object>
                </child>
                <property name="vexpand">True</property>
                <property name="valign">center</property>
              </object>
            </child>
            <property name="vexpand">True</property>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkWindow" id="supervisor_window">
    <child>
      <object class="GtkBox" id="root">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox" id="hbox1">
            <property name="orientation">horizontal</property>
            <child>
              <object class="GtkViewport" id="viewport1">
                <child>
                  <object class="GtkFrame" id="aspectframe1">
                    <property name="label-xalign">0</property>
                    <child>
                      <object class="GtkComboBox" id="pool_combobox">
                        <property name="model">pool_liststore</property>
                        <signal name="changed" handler="on_pool_combobox_changed" swapped="no" />
                        <child>
                          <object class="GtkCellRendererPixbuf" id="cellrendererpixbuf2" />
                          <attributes>
                            <attribute name="pixbuf">1</attribute>
                          </attributes>
                        </child>
                        <child>
                          <object class="GtkCellRendererText" id="cellrenderertext1" />
                          <attributes>
                            <attribute name="text">0</attribute>
                          </attributes>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="toolbar3">
                <property name="orientation">horizontal</property>
                <style>
                  <class name="toolbar" />
                </style>
                <child>
                  <object class="GtkButton" id="pool_filter_toolbutton">
                    <signal name="clicked" handler="on_pool_filter_toolbutton_clicked" swapped="no" />
                    <property name="has-frame">False</property>
                    <property name="tooltip-text" translatable="yes">Data</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">2</property>
                        <child>
                          <object class="GtkImage">
                            <property name="icon-name">format-justify-fill</property>
                            <property name="icon-size">large</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">Data</property>
                            <property name="use-underline">True</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="print_pool_toolbutton">
                    <signal name="clicked" handler="on_print_pool_toolbutton_clicked" swapped="no" />
                    <property name="has-frame">False</property>
                    <property name="tooltip-text" translatable="yes">Print</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">2</property>
                        <child>
                          <object class="GtkImage">
                            <property name="icon-name">document-print</property>
                            <property name="icon-size">large</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">_Print</property>
                            <property name="use-underline">True</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkSeparator" id="toolbutton4">
                    <property name="orientation">vertical</property>
                  </object>
                </child>
                <child>
                  <object class="GtkToggleButton" id="pool_classification_toggletoolbutton">
                    <signal name="toggled" handler="on_pool_classification_toggletoolbutton_toggled" swapped="no" />
                    <property name="has-frame">False</property>
                    <property name="tooltip-text" translatable="yes">Classification</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">2</property>
                        <child>
                          <object class="GtkImage" id="score_image4">
                            <property name="file">../glade/images/stock_scores.png</property>
                            <property name="pixel-size">-1</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">Classification</property>
                            <property name="use-underline">True</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkSeparator" id="toolbutton1">
                    <property name="orientation">vertical</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="stuff_toolbutton">
                    <signal name="clicked" handler="on_stuff_toolbutton_clicked" swapped="no" />
                    <property name="has-frame">False</property>
                    <property name="tooltip-text" translatable="yes">Automatic stuffing</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">2</property>
                        <child>
                          <object class="GtkImage" id="image1">
                            <property name="file">../glade/images/gnome-devel.png</property>
                            <property name="pixel-size">-1</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">Automatic stuffing</property>
                            <property name="use-underline">True</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <property name="hexpand">True</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="hbox2">
            <property name="orientation">horizontal</property>
            <child>
              <object class="GtkViewport" id="main_hook">
                <property name="hexpand">True</property>
              </object>
            </child>
            <child>
              <object class="GtkNotebook" id="classification_hook">
                <child>
                  <object class="GtkViewport" id="coumpound_classification_hook" />
                </child>
                <child type="tab">
                  <object class="GtkLabel" id="label6">
                    <property name="label" translatable="yes">Combined classification</property>
                  </object>
                </child>
                <child>
                  <object class="GtkViewport" id="current_round_classification_hook" />
                </child>
                <child type="tab">
                  <object class="GtkLabel" id="label7">
                    <property name="label" translatable="yes">Single classification</property>
                  </object>
                </child>
                <property name="hexpand">True</property>
              </object>
            </child>
            <property name="vexpand">True</property>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkImage" id="smartpool_image">
    <property name="file">../glade/images/smartphone.png</property>
    <property name="pixel-size">-1</property>
  </object>
</interface>
