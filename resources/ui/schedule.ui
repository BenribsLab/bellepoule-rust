<?xml version="1.0" encoding="UTF-8"?>
<!-- Converti depuis resources/glade/schedule.glade (GTK2) vers GTK4.
     Préfixe des actions de menus : schedule -->
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkWindow" id="config_window">
    <child>
      <object class="GtkBox" id="config_vbox">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox" id="config_toolbar">
            <property name="orientation">horizontal</property>
            <style>
              <class name="toolbar" />
            </style>
            <child>
              <object class="GtkMenuButton" id="add_stage_toolbutton">
                <property name="sensitive">False</property>
                <property name="has-frame">False</property>
                <property name="tooltip-text" translatable="yes">Add</property>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">2</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">list-add</property>
                        <property name="icon-size">large</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Add</property>
                        <property name="use-underline">True</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="remove_stage_toolbutton">
                <property name="sensitive">False</property>
                <signal name="clicked" handler="on_remove_stage_toolbutton_clicked" swapped="no" />
                <property name="has-frame">False</property>
                <property name="tooltip-text" translatable="yes">Remove</property>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">2</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">list-remove</property>
                        <property name="icon-size">large</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Remove</property>
                        <property name="use-underline">True</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="move_stage_up_toolbutton">
                <property name="sensitive">False</property>
                <signal name="clicked" handler="on_move_stage_up_toolbutton_clicked" swapped="no" />
                <property name="has-frame">False</property>
                <property name="tooltip-text" translatable="yes">Move up</property>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">2</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">go-up</property>
                        <property name="icon-size">large</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Move up</property>
                        <property name="use-underline">True</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="move_stage_down_toolbutton">
                <property name="sensitive">False</property>
                <signal name="clicked" handler="on_move_stage_down_toolbutton_clicked" swapped="no" />
                <property name="has-frame">False</property>
                <property name="tooltip-text" translatable="yes">Move down</property>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">2</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">go-down</property>
                        <property name="icon-size">large</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Move down</property>
                        <property name="use-underline">True</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkSeparator" id="separatortoolitem1">
                <property name="orientation">vertical</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="print_schedule_toolbutton">
                <signal name="clicked" handler="on_print_schedule_toolbutton_clicked" swapped="no" />
                <property name="has-frame">False</property>
                <property name="tooltip-text" translatable="yes">Print</property>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">2</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">document-print</property>
                        <property name="icon-size">large</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">_Print</property>
                        <property name="use-underline">True</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="hbox1">
            <property name="orientation">horizontal</property>
            <property name="spacing">20</property>
            <child>
              <object class="GtkFrame" id="frame1">
                <property name="label-xalign">0</property>
                <child>
                  <object class="GtkTreeView" id="formula_treeview">
                    <property name="model">stage_liststore_filter</property>
                    <property name="headers-visible">False</property>
                    <property name="search-column">0</property>
                    <signal name="cursor-changed" handler="on_formula_treeview_cursor_changed" swapped="no" />
                    <property name="headers-clickable">False</property>
                    <child>
                      <object class="GtkTreeViewColumn" id="treeviewcolumn1">
                        <property name="title">Schedule</property>
                        <child>
                          <object class="GtkCellRendererPixbuf" id="lock_cellrendererpixbuf" />
                          <attributes>
                            <attribute name="icon-name">1</attribute>
                          </attributes>
                        </child>
                        <child>
                          <object class="GtkCellRendererText" id="name_cellrenderertext" />
                          <attributes>
                            <attribute name="text">0</attribute>
                          </attributes>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child type="label">
                  <object class="GtkLabel" id="label1">
                    <property name="label" translatable="yes">&lt;b&gt;Schedule&lt;/b&gt;</property>
                    <property name="use-markup">True</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkFrame" id="frame2">
                <property name="label-xalign">0</property>
                <child>
                  <object class="GtkFrame" id="module_config_hook">
                    <property name="label-xalign">0</property>
                  </object>
                </child>
                <child type="label">
                  <object class="GtkLabel" id="label2">
                    <property name="label" translatable="yes">&lt;b&gt;Parameters&lt;/b&gt;</property>
                    <property name="use-markup">True</property>
                  </object>
                </child>
                <property name="hexpand">True</property>
              </object>
            </child>
            <property name="vexpand">True</property>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkListStore" id="stage_liststore">
    <columns>
      <column type="gchararray" />
      <column type="gchararray" />
      <column type="gpointer" />
      <column type="gboolean" />
    </columns>
  </object>
  <object class="GtkTreeModelFilter" id="stage_liststore_filter">
    <property name="child-model">stage_liststore</property>
  </object>
  <object class="GtkWindow" id="window">
    <child>
      <object class="GtkBox" id="vbox1">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox" id="toolbar">
            <property name="orientation">horizontal</property>
            <style>
              <class name="toolbar" />
            </style>
            <child>
              <object class="GtkButton" id="previous_stage_toolbutton">
                <signal name="clicked" handler="on_previous_stage_toolbutton_clicked" swapped="no" />
                <property name="has-frame">False</property>
                <property name="tooltip-text" translatable="yes">Previous round</property>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">2</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">go-previous</property>
                        <property name="icon-size">large</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Previous round</property>
                        <property name="use-underline">True</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="next_stage_toolbutton">
                <signal name="clicked" handler="on_next_stage_toolbutton_clicked" swapped="no" />
                <property name="has-frame">False</property>
                <property name="tooltip-text" translatable="yes">Next round</property>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">2</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">go-next</property>
                        <property name="icon-size">large</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Next round</property>
                        <property name="use-underline">True</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="error_toolbutton">
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkViewport" id="error_viewport">
                    <child>
                      <object class="GtkLabel" id="error_label">
                        <property name="label">label</property>
                        <property name="use-markup">True</property>
                      </object>
                    </child>
                    <property name="hexpand">True</property>
                    <property name="vexpand">True</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkNotebook" id="schedule_notebook">
            <property name="vexpand">True</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
