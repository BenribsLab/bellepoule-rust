<?xml version="1.0" encoding="UTF-8"?>
<!-- Converti depuis resources/glade/competition.glade (GTK2) vers GTK4.
     Préfixe des actions de menus : competition -->
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkImage" id="apply_animation">
    <property name="file">../glade/images/apply.gif</property>
    <property name="pixel-size">-1</property>
  </object>
  <object class="GtkWindow" id="window">
    <child>
      <object class="GtkNotebook" id="notebook">
        <child>
          <object class="GtkBox" id="root">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkCheckButton" id="batch_group">
                <property name="receives-default">False</property>
                <property name="visible">False</property>
                <property name="label">radiobutton</property>
                <property name="active">True</property>
                <property name="vexpand">True</property>
              </object>
            </child>
            <child>
              <object class="GtkViewport" id="viewport1">
                <child>
                  <object class="GtkGrid" id="batch_table">
                    <property name="column-spacing">5</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="batch_vbox">
                <property name="orientation">vertical</property>
                <property name="vexpand">True</property>
              </object>
            </child>
          </object>
        </child>
        <child type="tab">
          <object class="GtkBox" id="notebook_title">
            <property name="orientation">vertical</property>
            <property name="spacing">3</property>
            <child>
              <object class="GtkBox" id="color_box">
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkBox" id="vbox2">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkLabel" id="competition_gender_label">
                        <property name="label">Man</property>
                        <attributes>
                          <attribute name="weight" value="bold" />
                        </attributes>
                        <property name="vexpand">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="competition_weapon_label">
                        <property name="label">Sabre</property>
                        <attributes>
                          <attribute name="weight" value="bold" />
                        </attributes>
                        <property name="vexpand">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="competition_category_label">
                        <property name="label">U16</property>
                        <attributes>
                          <attribute name="weight" value="bold" />
                        </attributes>
                        <property name="vexpand">True</property>
                      </object>
                    </child>
                    <property name="hexpand">True</property>
                    <property name="vexpand">True</property>
                  </object>
                </child>
                <property name="vexpand">True</property>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="hbox">
                <property name="orientation">horizontal</property>
                <child>
                  <object class="GtkImage" id="batch_image">
                    <property name="icon-name">dialog-question</property>
                    <property name="halign">end</property>
                    <property name="hexpand">True</property>
                  </object>
                </child>
                <property name="vexpand">True</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
