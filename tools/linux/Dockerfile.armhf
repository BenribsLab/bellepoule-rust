# Compilation croisée de ManageComp pour Linux ARM 32 bits (armhf :
# Raspberry Pi OS 32 bits, Raspberry Pi 2 à 5), lancée par tools/release.py.
# Ubuntu 24.04 : GTK 4.14 (le logiciel demande GTK 4.12 ou plus récent).
#
# Les bibliothèques ARM (GTK et ses dépendances) sont téléchargées puis
# simplement dépliées dans /sysroot, sans être installées : la compilation
# s'y réfère, sans exécuter aucun programme ARM.
FROM ubuntu:24.04
RUN dpkg --add-architecture armhf \
 && sed -i 's/^Types: deb$/Types: deb\nArchitectures: amd64/' /etc/apt/sources.list.d/ubuntu.sources \
 && printf 'Types: deb\nURIs: http://ports.ubuntu.com/ubuntu-ports\nSuites: noble noble-updates noble-security\nComponents: main universe\nArchitectures: armhf\nSigned-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg\n' > /etc/apt/sources.list.d/ports.sources \
 && apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl build-essential pkg-config gcc-arm-linux-gnueabihf libc6-dev-armhf-cross \
 && mkdir -p /tmp/debs /sysroot && cd /tmp/debs \
 && apt-cache depends --recurse --no-recommends --no-suggests --no-conflicts --no-breaks --no-replaces --no-enhances \
      libgtk-4-dev:armhf libudev-dev:armhf \
    | grep -E '^[a-z0-9]' | grep -v ':amd64' | sort -u > list \
 && for p in $(cat list); do apt-get download "$p" >/dev/null 2>&1 || true; done \
 && for d in *.deb; do dpkg -x "$d" /sysroot; done \
 && cd / && rm -rf /tmp/debs /var/lib/apt/lists/*
# Les scripts d'édition de liens de la glibc ARM (libc.so, libm.so) citent
# /lib/arm-linux-gnueabihf et /lib/ld-linux-armhf.so.3 : ces chemins mènent
# aux fichiers dépliés.
RUN mkdir -p /usr/lib/arm-linux-gnueabihf \
 && cp -rsn /sysroot/usr/lib/arm-linux-gnueabihf/. /usr/lib/arm-linux-gnueabihf/ \
 && ln -sf /sysroot/usr/lib/ld-linux-armhf.so.3 /usr/lib/ld-linux-armhf.so.3
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable \
 && /root/.cargo/bin/rustup target add armv7-unknown-linux-gnueabihf
ENV PATH=/root/.cargo/bin:$PATH
# Remplace les chemins GTK de Windows fixés dans .cargo/config.toml ; cible ARM.
ENV PKG_CONFIG=pkg-config \
    PKG_CONFIG_ALLOW_CROSS=1 \
    PKG_CONFIG_SYSROOT_DIR=/sysroot \
    PKG_CONFIG_PATH= \
    PKG_CONFIG_LIBDIR=/sysroot/usr/lib/arm-linux-gnueabihf/pkgconfig:/sysroot/usr/share/pkgconfig \
    CARGO_BUILD_TARGET=armv7-unknown-linux-gnueabihf \
    CARGO_TARGET_ARMV7_UNKNOWN_LINUX_GNUEABIHF_LINKER=arm-linux-gnueabihf-gcc \
    CARGO_TARGET_ARMV7_UNKNOWN_LINUX_GNUEABIHF_RUSTFLAGS="-C link-arg=-Wl,-rpath-link,/sysroot/usr/lib/arm-linux-gnueabihf -C link-arg=-Wl,-rpath-link,/sysroot/lib/arm-linux-gnueabihf -C link-arg=-L/sysroot/usr/lib/arm-linux-gnueabihf" \
    CC_armv7_unknown_linux_gnueabihf=arm-linux-gnueabihf-gcc \
    CFLAGS_armv7_unknown_linux_gnueabihf=-I/sysroot/usr/include
WORKDIR /src
